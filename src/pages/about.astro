---
// about.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="About — staring at the ceiling" description="About staring at the ceiling.">
  <div class="max-w-2xl space-y-8">
    <header class="pb-5 border-b border-[#d8dce2] dark:border-[#333a46]">
      <h1 class="font-mono text-base font-semibold tracking-wide text-zinc-900 dark:text-zinc-100">
        About
      </h1>
      <p class="text-xs font-mono text-zinc-400 dark:text-zinc-500 mt-1">
        staring at the ceiling
      </p>
    </header>

    <div class="prose max-w-none text-sm sm:text-base leading-relaxed text-zinc-700 dark:text-zinc-300 space-y-4">
      <p>
        <strong>staring at the ceiling</strong> is a personal blog and notebook for thoughts, ideas, technical notes, and things noticed along the way.
      </p>
      <p>
        Clean, minimalist, and distraction-free.
      </p>
    </div>

    <div class="pt-6 border-t border-[#d8dce2] dark:border-[#333a46]">
      <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 space-y-2">
        <p>
          Author: <span class="text-zinc-800 dark:text-zinc-200">Mohammed Alim Uddin</span>
        </p>
        <p>
          Repository: <a href="https://github.com/MohammedAlimUddin/staring-at-the-ceiling" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">github.com/MohammedAlimUddin/staring-at-the-ceiling</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
