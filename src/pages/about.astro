---
// about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — staring at the ceiling" description="About staring at the ceiling.">
  <article class="max-w-2xl space-y-6">
    <header class="pb-5 border-b border-[#d8dce2] dark:border-[#333a46]">
      <h1 class="font-mono text-base font-semibold tracking-wide text-zinc-900 dark:text-zinc-100">
        About
      </h1>
    </header>

    <div class="prose max-w-none">
      <p>
        A personal notebook for thoughts, ideas, and observations recorded without rush.
      </p>
      <p>
        Minimalist, fast, and distraction-free.
      </p>
    </div>
  </article>
</BaseLayout>
