---
// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="staring at the ceiling — unhurried thoughts">
  <div class="space-y-12">
    <!-- Hero / Manifesto Intro -->
    <header class="max-w-2xl py-6 border-b border-zinc-200/80 dark:border-zinc-800/80 space-y-4">
      <div class="inline-flex items-center space-x-2 px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span>staring at the ceiling</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight">
        Raw thoughts, unpolished drafts, and things noticed while looking up.
      </h1>

      <p class="text-zinc-600 dark:text-zinc-400 text-base leading-relaxed">
        A quiet sanctuary on the web. No artificial tone, no synthetic polish, no algorithm chasing. 
        Just personal reflections, mistakes intact, written as honestly as humanly possible.
      </p>
    </header>

    <!-- Latest Feature -->
    {latestPost && (
      <section class="space-y-4">
        <div class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 flex items-center space-x-2">
          <span>Latest reflection</span>
          <span class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1"></span>
        </div>

        <div class="p-6 sm:p-8 rounded-xl bg-white dark:bg-[#101216] border border-zinc-200 dark:border-zinc-800/80 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all shadow-sm">
          <div class="flex items-center space-x-3 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-3">
            <time datetime={latestPost.data.pubDate.toISOString()}>
              {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(latestPost.data.pubDate)}
            </time>
            <span>·</span>
            <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400 font-medium">
              {latestPost.data.category}
            </span>
          </div>

          <h2 class="text-2xl font-sans font-bold tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            <a href={`${baseUrl}/blog/${latestPost.slug}`}>
              {latestPost.data.title}
            </a>
          </h2>

          <p class="mt-3 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed line-clamp-3">
            {latestPost.data.description}
          </p>

          <div class="mt-5">
            <a
              href={`${baseUrl}/blog/${latestPost.slug}`}
              class="inline-flex items-center text-xs font-mono font-medium text-blue-600 dark:text-blue-400 hover:underline"
            >
              Read full entry &rarr;
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Prior Entries -->
    {otherPosts.length > 0 && (
      <section class="space-y-4">
        <div class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 flex items-center space-x-2">
          <span>Previous reflections</span>
          <span class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1"></span>
        </div>

        <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800/80">
          {otherPosts.map((post) => (
            <PostCard
              slug={post.slug}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
