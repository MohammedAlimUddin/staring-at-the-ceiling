---
// TableOfContents.astro
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  readingTime?: string;
}

const { headings, readingTime = '3 min read' } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="hidden xl:block w-56 shrink-0 pl-6">
  <div class="sticky top-16 space-y-5">
    <!-- Reading Time -->
    <div class="flex items-center space-x-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 pb-2.5 border-b border-[#d8dce2] dark:border-[#333a46]">
      <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{readingTime}</span>
    </div>

    <!-- Table of Contents -->
    {filteredHeadings.length > 0 && (
      <div class="space-y-2">
        <h4 class="text-[11px] font-mono font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
          Contents
        </h4>
        <nav class="toc-container text-xs font-sans space-y-1 max-h-[calc(100vh-14rem)] overflow-y-auto pr-1">
          {filteredHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              class={`toc-link block py-1 transition-colors ${
                h.depth === 3 ? 'pl-2.5 text-zinc-500 dark:text-zinc-500' : 'text-zinc-600 dark:text-zinc-400'
              } hover:text-blue-600 dark:hover:text-blue-400`}
              data-slug={h.slug}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </div>
    )}
  </div>
</aside>

<script>
  function setupTOC() {
    const links = document.querySelectorAll('.toc-link');
    if (links.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            links.forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('text-blue-600', 'dark:text-blue-400', 'font-medium');
                link.classList.remove('text-zinc-600', 'text-zinc-500', 'dark:text-zinc-400', 'dark:text-zinc-500');
              } else {
                link.classList.remove('text-blue-600', 'dark:text-blue-400', 'font-medium');
                link.classList.add('text-zinc-600', 'dark:text-zinc-400');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0% -60% 0%' }
    );

    document.querySelectorAll('article h2, article h3').forEach((heading) => {
      observer.observe(heading);
    });
  }

  setupTOC();
  document.addEventListener('astro:page-load', setupTOC);
</script>
