---
// Sidebar.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
  categories?: { name: string; count: number }[];
  posts?: { slug: string; title: string; category: string }[];
}

const { currentPath = '', categories = [], posts = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- Desktop Sidebar & Mobile Drawer Wrapper -->
<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-72 bg-white/95 dark:bg-[#0c0d10]/95 backdrop-blur-md border-r border-zinc-200 dark:border-zinc-800/80 flex flex-col transition-transform duration-300 ease-in-out -translate-x-full md:translate-x-0"
>
  <!-- Sidebar Header / Branding -->
  <div class="p-5 border-b border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between">
    <a href={`${baseUrl}/`} class="group block">
      <div class="flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 ring-4 ring-blue-500/20 group-hover:scale-110 transition-transform"></span>
        <h1 class="font-sans font-semibold text-base tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          staring at the ceiling
        </h1>
      </div>
      <p class="text-[11px] text-zinc-400 dark:text-zinc-500 tracking-wide mt-1 pl-4 uppercase font-mono">
        thoughts & notes
      </p>
    </a>

    <!-- Mobile close button -->
    <button
      id="close-sidebar"
      type="button"
      class="md:hidden p-1.5 rounded-md text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200"
      aria-label="Close sidebar"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Search / Quick Filter -->
  <div class="px-4 py-3 border-b border-zinc-200/60 dark:border-zinc-800/60">
    <div class="relative">
      <input
        id="sidebar-search"
        type="text"
        placeholder="Filter notes..."
        class="w-full text-xs font-mono bg-zinc-100 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 rounded-md py-1.5 pl-8 pr-3 text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all"
      />
      <svg
        class="w-3.5 h-3.5 text-zinc-400 absolute left-2.5 top-2.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-6 text-sm">
    <!-- Main Menu -->
    <div class="space-y-1">
      <div class="px-2 pb-1.5 text-[11px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
        Navigation
      </div>
      <a
        href={`${baseUrl}/`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-sm font-medium transition-colors ${
          currentPath === '/' || currentPath === ''
            ? 'bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400'
            : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 hover:text-zinc-900 dark:hover:text-zinc-100'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Recent
      </a>
      <a
        href={`${baseUrl}/archive`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-sm font-medium transition-colors ${
          currentPath.includes('/archive')
            ? 'bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400'
            : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 hover:text-zinc-900 dark:hover:text-zinc-100'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Archive
      </a>
      <a
        href={`${baseUrl}/about`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-sm font-medium transition-colors ${
          currentPath.includes('/about')
            ? 'bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400'
            : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 hover:text-zinc-900 dark:hover:text-zinc-100'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        About
      </a>
    </div>

    <!-- Tree View / Index of Posts -->
    <div class="space-y-1">
      <div class="px-2 pb-1.5 text-[11px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
        Essays & Notes
      </div>
      <ul id="sidebar-post-list" class="space-y-0.5">
        {posts.map((post) => (
          <li class="sidebar-post-item" data-title={post.title.toLowerCase()} data-category={post.category.toLowerCase()}>
            <a
              href={`${baseUrl}/blog/${post.slug}`}
              class={`group flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors ${
                currentPath.includes(`/blog/${post.slug}`)
                  ? 'bg-zinc-200/70 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-medium'
                  : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-zinc-200'
              }`}
            >
              <span class="truncate">{post.title}</span>
              <span class="text-[10px] font-mono text-zinc-400 group-hover:text-zinc-500 dark:text-zinc-500 dark:group-hover:text-zinc-400 ml-2 shrink-0">
                {post.category}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p id="sidebar-no-results" class="hidden text-xs text-zinc-400 px-3 py-2 italic font-mono">
        No matching notes found
      </p>
    </div>
  </nav>

  <!-- Sidebar Footer -->
  <div class="p-3 border-t border-zinc-200/80 dark:border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
    <div class="flex items-center space-x-2">
      <ThemeToggle />
      <span class="font-mono text-[11px] text-zinc-400">Mode</span>
    </div>
    <a
      href="https://github.com/MohammedAlimUddin/staring-at-the-ceiling"
      target="_blank"
      rel="noopener noreferrer"
      class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors"
      title="View GitHub Repository"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
    </a>
  </div>
</aside>

<!-- Backdrop for mobile drawer -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-black/40 backdrop-blur-sm hidden md:hidden transition-opacity"
></div>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const closeBtn = document.getElementById('close-sidebar');
    const searchInput = document.getElementById('sidebar-search') as HTMLInputElement | null;
    const postItems = document.querySelectorAll('.sidebar-post-item');
    const noResults = document.getElementById('sidebar-no-results');

    function closeMobileSidebar() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    closeBtn?.addEventListener('click', closeMobileSidebar);
    backdrop?.addEventListener('click', closeMobileSidebar);

    // Instant filter
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let matchCount = 0;

        postItems.forEach((item) => {
          const title = item.getAttribute('data-title') || '';
          const category = item.getAttribute('data-category') || '';
          const matches = title.includes(query) || category.includes(query);

          if (matches) {
            (item as HTMLElement).style.display = '';
            matchCount++;
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });

        if (noResults) {
          if (matchCount === 0 && query !== '') {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  }

  setupSidebar();
  document.addEventListener('astro:page-load', setupSidebar);
</script>
