---
// Sidebar.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
  categories?: { name: string; count: number }[];
  posts?: { slug: string; title: string; category: string }[];
}

const { currentPath = '', categories = [], posts = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Clean normalized path without baseUrl prefix and trailing slash
const cleanPath = currentPath.replace(baseUrl, '').replace(/\/$/, '') || '/';
const isRecent = cleanPath === '/';
const isArchive = cleanPath.startsWith('/archive');
const isAbout = cleanPath.startsWith('/about');
---

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-40 w-72 bg-[#f8f9fb] dark:bg-[#21252d] border-r border-[#d8dce2] dark:border-[#333a46] flex flex-col"
>
  <!-- Header / Title -->
  <div class="px-4 py-3.5 border-b border-[#d8dce2] dark:border-[#333a46] flex items-center justify-between">
    <a href={`${baseUrl}/`} class="group block py-1">
      <span class="font-mono text-sm tracking-wide font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        staring at the ceiling
      </span>
    </a>

    <!-- Collapse Button -->
    <button
      id="sidebar-collapse-btn"
      type="button"
      class="p-1.5 rounded text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-200/50 dark:hover:bg-zinc-700/50 transition-colors"
      aria-label="Collapse sidebar"
      title="Collapse sidebar"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
      </svg>
    </button>
  </div>

  <!-- Search / Filter -->
  <div class="px-3.5 py-2.5 border-b border-[#d8dce2] dark:border-[#333a46]">
    <div class="relative">
      <svg
        class="w-3.5 h-3.5 text-zinc-400 absolute left-2.5 top-2.5 pointer-events-none"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="sidebar-search"
        type="text"
        placeholder="Filter notes..."
        class="w-full text-xs font-mono bg-[#edf0f4] dark:bg-[#191c22] border border-[#d8dce2] dark:border-[#333a46] rounded pl-8 pr-2.5 py-1.5 text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 focus:outline-none focus:border-zinc-400 dark:focus:border-zinc-500 transition-colors"
      />
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 overflow-y-auto px-3 py-3 space-y-4">
    <!-- Main Tabs -->
    <div class="space-y-1">
      <div class="px-2 pb-1 text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-semibold">
        Navigation
      </div>
      <a
        href={`${baseUrl}/`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-colors ${
          isRecent
            ? 'bg-[#e2e6ed] text-[#191c21] dark:bg-[#2c323f] dark:text-[#f0f2f5] font-semibold'
            : 'text-[#4a515e] dark:text-[#9ea7b5] hover:bg-[#eaecef] dark:hover:bg-[#262b35] hover:text-[#191c21] dark:hover:text-[#f0f2f5]'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Recent</span>
      </a>
      <a
        href={`${baseUrl}/archive`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-colors ${
          isArchive
            ? 'bg-[#e2e6ed] text-[#191c21] dark:bg-[#2c323f] dark:text-[#f0f2f5] font-semibold'
            : 'text-[#4a515e] dark:text-[#9ea7b5] hover:bg-[#eaecef] dark:hover:bg-[#262b35] hover:text-[#191c21] dark:hover:text-[#f0f2f5]'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Archive</span>
      </a>
      <a
        href={`${baseUrl}/about`}
        class={`flex items-center px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-colors ${
          isAbout
            ? 'bg-[#e2e6ed] text-[#191c21] dark:bg-[#2c323f] dark:text-[#f0f2f5] font-semibold'
            : 'text-[#4a515e] dark:text-[#9ea7b5] hover:bg-[#eaecef] dark:hover:bg-[#262b35] hover:text-[#191c21] dark:hover:text-[#f0f2f5]'
        }`}
      >
        <svg class="w-4 h-4 mr-2.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>About</span>
      </a>
    </div>

    <!-- Notes list -->
    {posts.length > 0 && (
      <div class="pt-3 border-t border-[#d8dce2] dark:border-[#333a46] space-y-1">
        <div class="px-2 pb-1 text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-semibold">
          Notes ({posts.length})
        </div>
        <ul id="sidebar-post-list" class="space-y-0.5">
          {posts.map((post) => {
            const isPostActive = cleanPath.startsWith(`/blog/${post.slug}`);
            return (
              <li class="sidebar-post-item" data-title={post.title.toLowerCase()} data-category={post.category.toLowerCase()}>
                <a
                  href={`${baseUrl}/blog/${post.slug}`}
                  class={`flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition-colors ${
                    isPostActive
                      ? 'bg-[#e2e6ed] text-[#191c21] dark:bg-[#2c323f] dark:text-[#f0f2f5] font-medium'
                      : 'text-zinc-600 dark:text-zinc-400 hover:bg-[#eaecef] dark:hover:bg-[#262b35] hover:text-zinc-900 dark:hover:text-zinc-100'
                  }`}
                >
                  <span class="truncate">{post.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <p id="sidebar-no-results" class="hidden text-xs text-zinc-400 px-2 py-1.5 italic font-mono">
          No matches
        </p>
      </div>
    )}
  </nav>

  <!-- Footer -->
  <div class="p-3 border-t border-[#d8dce2] dark:border-[#333a46] flex items-center justify-between text-xs text-zinc-500">
    <ThemeToggle />
    <a
      href="https://github.com/MohammedAlimUddin/staring-at-the-ceiling"
      target="_blank"
      rel="noopener noreferrer"
      class="p-2 rounded text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors"
      title="GitHub"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
    </a>
  </div>
</aside>

<!-- Mobile backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-black/40 backdrop-blur-sm hidden md:hidden transition-opacity"
></div>

<script is:inline>
  function setupSidebarSearch() {
    const searchInput = document.getElementById('sidebar-search');
    const postItems = document.querySelectorAll('.sidebar-post-item');
    const noResults = document.getElementById('sidebar-no-results');

    if (searchInput) {
      searchInput.oninput = (e) => {
        const query = e.target.value.toLowerCase().trim();
        let matchCount = 0;
        postItems.forEach((item) => {
          const title = item.getAttribute('data-title') || '';
          const category = item.getAttribute('data-category') || '';
          const matches = title.includes(query) || category.includes(query);
          item.style.display = matches ? '' : 'none';
          if (matches) matchCount++;
        });
        if (noResults) {
          noResults.classList.toggle('hidden', matchCount > 0 || query === '');
        }
      };
    }
  }

  setupSidebarSearch();
  document.addEventListener('astro:after-swap', setupSidebarSearch);
  document.addEventListener('astro:page-load', setupSidebarSearch);
</script>
