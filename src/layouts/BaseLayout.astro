---
// BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'staring at the ceiling',
  description = 'Personal notes and writings.'
} = Astro.props;

const pathname = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Fetch posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sidebarPosts = sortedPosts.map((p) => ({
  slug: p.slug,
  title: p.data.title,
  category: p.data.category
}));

const categoryMap = new Map<string, number>();
sortedPosts.forEach((p) => {
  const cat = p.data.category || 'General';
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});
const categories = Array.from(categoryMap.entries()).map(([name, count]) => ({ name, count }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <ClientRouter />

    <!-- Synchronous inline theme & layout check to avoid flash & keep state across transitions -->
    <script is:inline>
      function getActiveTheme() {
        try {
          return localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {
          return 'light';
        }
      }

      function applyInitialState() {
        try {
          const isDark = getActiveTheme() === 'dark';
          document.documentElement.classList.toggle('dark', isDark);

          const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
          document.documentElement.classList.toggle('sidebar-collapsed', isCollapsed);
        } catch (e) {}
      }

      applyInitialState();

      // Ensure theme & sidebar states are applied to incoming document BEFORE Astro swaps DOM
      document.addEventListener('astro:before-swap', (ev) => {
        try {
          const isDark = getActiveTheme() === 'dark';
          ev.newDocument.documentElement.classList.toggle('dark', isDark);

          const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
          ev.newDocument.documentElement.classList.toggle('sidebar-collapsed', isCollapsed);
        } catch (e) {}
      });
    </script>
  </head>
  <body class="antialiased min-h-screen">
    <!-- Top Header -->
    <Header />

    <!-- Sidebar Navigation -->
    <Sidebar currentPath={pathname} categories={categories} posts={sidebarPosts} />

    <!-- Main Content Area -->
    <div id="main-wrapper" class="flex flex-col min-h-screen">
      <main class="flex-1 max-w-4xl w-full mx-auto px-5 sm:px-8 py-8 md:py-12">
        <slot />
      </main>

      <footer class="border-t border-[#d8dce2] dark:border-[#333a46] py-6 px-6 text-center text-xs font-mono text-zinc-400 dark:text-zinc-500">
        <p>staring at the ceiling</p>
      </footer>
    </div>

    <!-- Idempotent Sidebar Controller Script -->
    <script is:inline>
      function toggleSidebar() {
        const isMobile = window.innerWidth < 768;
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');

        if (isMobile) {
          if (!sidebar) return;
          const isOpen = sidebar.classList.toggle('mobile-open');
          if (backdrop) backdrop.classList.toggle('hidden', !isOpen);
          document.body.classList.toggle('overflow-hidden', isOpen);
        } else {
          const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
          try {
            localStorage.setItem('sidebar-collapsed', isCollapsed ? 'true' : 'false');
          } catch (e) {}
        }
      }

      function closeMobileSidebar() {
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar) sidebar.classList.remove('mobile-open');
        if (backdrop) backdrop.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }

      function initSidebarEvents() {
        const headerBtn = document.getElementById('global-sidebar-toggle');
        const collapseBtn = document.getElementById('sidebar-collapse-btn');
        const backdrop = document.getElementById('sidebar-backdrop');

        if (headerBtn) headerBtn.onclick = toggleSidebar;
        if (collapseBtn) collapseBtn.onclick = toggleSidebar;
        if (backdrop) backdrop.onclick = closeMobileSidebar;
      }

      initSidebarEvents();
      document.addEventListener('astro:after-swap', initSidebarEvents);
      document.addEventListener('astro:page-load', initSidebarEvents);
    </script>
  </body>
</html>
