---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime?: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  pubDate,
  category,
  tags = [],
  headings,
  readingTime = '3 min read',
  prevPost,
  nextPost
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(pubDate);
---

<BaseLayout title={`${title} — staring at the ceiling`} description={description}>
  <ReadingProgress />

  <div class="flex justify-between items-start gap-8">
    <!-- Main Article Body -->
    <article class="flex-1 max-w-2xl w-full min-w-0">
      <!-- Article Header -->
      <header class="pb-6 mb-6 border-b border-[#d8dce2] dark:border-[#333a46]">
        <div class="flex items-center space-x-2.5 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-2.5">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span class="px-2 py-0.5 rounded bg-[#e4e7ec] dark:bg-[#2a303a] text-zinc-700 dark:text-zinc-300">
            {category}
          </span>
          <span>·</span>
          <span>{readingTime}</span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-sans font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-snug">
          {title}
        </h1>

        {description && (
          <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {description}
          </p>
        )}

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-3 pt-1">
            {tags.map((tag) => (
              <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Markdown Prose Content -->
      <div class="prose max-w-none">
        <slot />
      </div>

      <!-- Prev / Next Navigation -->
      {(prevPost || nextPost) && (
        <footer class="mt-12 pt-6 border-t border-[#d8dce2] dark:border-[#333a46]">
          <nav class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {prevPost ? (
              <a
                href={`${baseUrl}/blog/${prevPost.slug}`}
                class="p-3 rounded border border-[#d8dce2] dark:border-[#333a46] hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
              >
                <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider block mb-0.5">
                  &larr; Previous
                </span>
                <span class="text-xs font-medium text-zinc-800 dark:text-zinc-200 line-clamp-1">
                  {prevPost.title}
                </span>
              </a>
            ) : <div />}

            {nextPost && (
              <a
                href={`${baseUrl}/blog/${nextPost.slug}`}
                class="p-3 rounded border border-[#d8dce2] dark:border-[#333a46] hover:border-blue-500 dark:hover:border-blue-400 transition-colors text-right sm:col-start-2"
              >
                <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider block mb-0.5">
                  Next &rarr;
                </span>
                <span class="text-xs font-medium text-zinc-800 dark:text-zinc-200 line-clamp-1">
                  {nextPost.title}
                </span>
              </a>
            )}
          </nav>
        </footer>
      )}
    </article>

    <!-- Desktop Sticky Right TOC (No back to top button) -->
    <TableOfContents headings={headings} readingTime={readingTime} />
  </div>
</BaseLayout>
