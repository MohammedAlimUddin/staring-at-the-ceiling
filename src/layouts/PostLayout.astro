---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  readingTime?: string;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  pubDate,
  category,
  tags = [],
  headings,
  readingTime = '3 min read',
  prevPost,
  nextPost
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);
---

<BaseLayout title={`${title} | staring at the ceiling`} description={description}>
  <ReadingProgress />

  <div class="flex justify-between items-start">
    <!-- Main Article Body -->
    <article class="flex-1 max-w-2xl w-full min-w-0">
      <!-- Article Header -->
      <header class="pb-8 mb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
        <div class="flex items-center space-x-3 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-3">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          <span>·</span>
          <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400 font-medium">
            {category}
          </span>
          <span>·</span>
          <span>{readingTime}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-sans font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight">
          {title}
        </h1>

        {description && (
          <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400 font-serif italic leading-relaxed">
            "{description}"
          </p>
        )}

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4 pt-2">
            {tags.map((tag) => (
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Markdown Prose Content -->
      <div class="prose max-w-none">
        <slot />
      </div>

      <!-- Article Footer & Prev/Next Navigation -->
      <footer class="mt-12 pt-8 border-t border-zinc-200/80 dark:border-zinc-800/80 space-y-6">
        <div class="p-4 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-500 dark:text-zinc-400">
          <p>Written by human hands. Untouched by machine polish.</p>
        </div>

        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`${baseUrl}/blog/${prevPost.slug}`}
              class="group p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
            >
              <span class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">
                &larr; Previous Thought
              </span>
              <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1">
                {prevPost.title}
              </span>
            </a>
          ) : <div />}

          {nextPost && (
            <a
              href={`${baseUrl}/blog/${nextPost.slug}`}
              class="group p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-blue-500 dark:hover:border-blue-400 transition-colors text-right sm:col-start-2"
            >
              <span class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider block mb-1">
                Next Thought &rarr;
              </span>
              <span class="text-sm font-medium text-zinc-800 dark:text-zinc-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1">
                {nextPost.title}
              </span>
            </a>
          )}
        </nav>
      </footer>
    </article>

    <!-- Desktop Sticky Right TOC -->
    <TableOfContents headings={headings} readingTime={readingTime} />
  </div>
</BaseLayout>
